---
import { getCurrentTerm, getSpecialisation, listCourses, listIncompatibilities, listPlan, listPrerequisites } from "../lib/db";
import { completedBefore, missingPrereqs } from "../lib/prerequisites";
import { checkDuplicate, checkIncompatible, pairLock, semesterConflict } from "../lib/plan-integrity";
import { allGroups, computeProgress, groupsForSpecialisation } from "../lib/requirements";
import type { SpecialisationKey } from "../lib/specialisations";
import { termLabel, termSemester } from "../lib/terms";
import "../styles.css";

const currentTerm = getCurrentTerm();
const specialisation = getSpecialisation() as SpecialisationKey | null;
const requestedTerm = Number(Astro.url.searchParams.get("term"));
const term = requestedTerm >= 1 && requestedTerm <= 4 ? requestedTerm : currentTerm;
const returnTo = `/select/?term=${term}`;
const lockedCode = Astro.url.searchParams.get("locked");
const duplicateCode = Astro.url.searchParams.get("duplicate");
const nonconsecutiveCode = Astro.url.searchParams.get("nonconsecutive");
const notOfferedCode = Astro.url.searchParams.get("notoffered");
const incompatibleCode = Astro.url.searchParams.get("incompatible");
const pairedCode = Astro.url.searchParams.get("paired");
const noRoomCode = Astro.url.searchParams.get("noroom");
const slotParam = Astro.url.searchParams.get("slot");
const slotPrefix = slotParam ? `Slot ${slotParam}: ` : "";

const courses = listCourses();
const plan = listPlan();
const prereqs = listPrerequisites();
const incompatibilities = listIncompatibilities();
const courseByCode = new Map(courses.map((c) => [c.code, c]));
const planByPosition = new Map(
  plan.filter((p) => p.term === term).map((p) => [p.position, p]),
);
const progress = computeProgress(courses, plan, specialisation);
const outstanding = progress.filter((g) => !g.satisfied);

// Once a specialisation is chosen, the picker narrows to just its own
// groups (plus the universal ones) — no more browsing the other 6
// specialisations' lists. Undecided still gets every specialisation's
// groups, so "先选课" (pick courses first) isn't blocked.
const pickerGroups = specialisation ? groupsForSpecialisation(specialisation) : allGroups();
const pickerCodes = new Set(pickerGroups.flatMap((g) => g.courseCodes));

const completed = completedBefore(plan, term);
function missingFor(courseCode: string): string[] {
  return missingPrereqs(courseCode, prereqs, completed);
}

// <option> text can't carry CSS, so it gets a plain star string rounded to
// the nearest whole star; the fractional CSS version (--pct) is reserved
// for the slot-detail rating below, which is a plain <p> and can style it.
function starGlyphs(rating: number): string {
  const filled = Math.round(rating);
  return "★".repeat(filled) + "☆".repeat(5 - filled);
}

const semester = termSemester(term);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>This semester — Term {term}</title>
  </head>
  <body>
    <nav aria-label="site">
      <div class="nav-brand">7706XMCOMP</div>
      <a href="/">Roadmap</a>
      <a href="/select/" aria-current="page">This semester</a>
      <a href="/completed/">Completed</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h1>
        Term {term} <span class="term-card-label">{termLabel(term)}</span>
      </h1>
      <p>
        {term === currentTerm
          ? "Your current semester."
          : `Editing a ${term < currentTerm ? "past" : "future"} term — jump back to the current one from the roadmap.`}
      </p>

      {lockedCode && (
        <p class="banner banner-warning">
          🔒 {slotPrefix}<strong>{lockedCode}</strong> needs its prerequisite(s) completed first — nothing was saved.
        </p>
      )}

      {duplicateCode && (
        <p class="banner banner-warning">
          🔁 {slotPrefix}<strong>{duplicateCode}</strong> is already planned in another slot — a course can only count once. Nothing was saved.
        </p>
      )}

      {nonconsecutiveCode && (
        <p class="banner banner-warning">
          🔁 {slotPrefix}<strong>{nonconsecutiveCode}</strong> spans two terms — it must be taken in two <em>consecutive</em> terms. Nothing was saved.
        </p>
      )}

      {notOfferedCode && (
        <p class="banner banner-warning">
          📅 {slotPrefix}<strong>{notOfferedCode}</strong> isn't offered in {semester}. Nothing was saved.
        </p>
      )}

      {incompatibleCode && (
        <p class="banner banner-warning">
          🚫 {slotPrefix}<strong>{incompatibleCode}</strong> can't be taken together with a course already in your plan — nothing was saved.
        </p>
      )}

      {pairedCode && (
        <p class="banner banner-warning">
          🧩 {slotPrefix}<strong>{pairedCode}</strong> can't be placed here — this slot is locked as one half of a 2-term course. Clear it (which clears both halves) if you want to change it. Nothing was saved.
        </p>
      )}

      {noRoomCode && (
        <p class="banner banner-warning">
          🧩 {slotPrefix}<strong>{noRoomCode}</strong> spans two consecutive terms and needs slot {slotParam} free in an adjacent term for its second half, but it isn't available in either direction. Nothing was saved.
        </p>
      )}

      <div class="select-layout">
        <div class="card">
          <form method="post" action="/api/plan">
            <input type="hidden" name="term" value={term} />
            <input type="hidden" name="returnTo" value={returnTo} />
            <table class="plan-grid slot-grid">
              <caption class="visually-hidden">Term {term} slots</caption>
              <thead>
                <tr>
                  <th scope="col">Slot</th>
                  <th scope="col">Course</th>
                </tr>
              </thead>
              <tbody>
                {[1, 2, 3, 4].map((position) => {
                  const entry = planByPosition.get(position);
                  const course = entry ? courseByCode.get(entry.courseCode) : undefined;
                  const isConflict = course ? semesterConflict(course, term) : false;
                  const courseMissing = course ? missingFor(course.code) : [];
                  const pairInfo = pairLock(plan, courses, term, position);
                  return (
                    <tr class={isConflict ? "slot conflict" : "slot"}>
                      <th scope="row">{position}</th>
                      <td>
                        <label class="visually-hidden" for={`select-${position}`}>
                          Term {term}, slot {position}
                        </label>
                        <select id={`select-${position}`} name={`courseCode-${position}`}>
                          <option value="">— empty —</option>
                          {pickerGroups.map((group) => (
                            <optgroup label={group.label}>
                              {courses
                                .filter((c) => group.courseCodes.includes(c.code))
                                .map((c) => {
                                  const isSelf = c.code === course?.code;
                                  const missing = missingFor(c.code);
                                  const dup = checkDuplicate(c, plan, term, position);
                                  const offSemester = semesterConflict(c, term);
                                  const incompatible = checkIncompatible(c, plan, incompatibilities, term, position);
                                  const locked =
                                    (missing.length > 0 ||
                                      dup.blocked ||
                                      offSemester ||
                                      incompatible.blocked ||
                                      pairInfo.blocked) &&
                                    !isSelf;
                                  const icon = !locked
                                    ? ""
                                    : dup.blocked
                                      ? "🔁 "
                                      : incompatible.blocked
                                        ? "🚫 "
                                        : missing.length > 0
                                          ? "🔒 "
                                          : offSemester
                                            ? "📅 "
                                            : "🧩 ";
                                  const reason = !locked
                                    ? ""
                                    : dup.blocked
                                      ? dup.reason === "non-consecutive"
                                        ? ` — must be consecutive with Term ${dup.otherEntry?.term}`
                                        : ` — already in Term ${dup.otherEntry?.term}`
                                      : incompatible.blocked
                                        ? ` — incompatible with ${incompatible.otherEntry?.courseCode} (Term ${incompatible.otherEntry?.term})`
                                        : missing.length > 0
                                          ? ` — needs ${missing.join(", ")}`
                                          : offSemester
                                            ? ` — not offered in ${semester}`
                                            : ` — locked: paired with Term ${pairInfo.pairedTerm}`;
                                  return (
                                    <option value={c.code} selected={isSelf} disabled={locked}>
                                      {icon}
                                      {c.code} — {c.title} ({c.semester}) · {starGlyphs(c.rating)} {c.rating.toFixed(1)}
                                      {c.termSpan > 1 ? " · spans 2 terms" : ""}
                                      {reason}
                                    </option>
                                  );
                                })}
                            </optgroup>
                          ))}
                          {course && !pickerCodes.has(course.code) && (
                            <optgroup label="Outside your specialisation (already planned)">
                              <option value={course.code} selected>
                                {course.code} — {course.title} ({course.semester}) · {starGlyphs(course.rating)} {course.rating.toFixed(1)}
                              </option>
                            </optgroup>
                          )}
                        </select>
                        {course && (
                          <p class="slot-detail">
                            {course.units} units ·{" "}
                            <span
                              class="star-rating"
                              style={`--pct: ${Math.max(0, Math.min(100, (course.rating / 5) * 100))}%`}
                              role="img"
                              aria-label={`Rating ${course.rating.toFixed(1)} out of 5`}
                            >
                              ★★★★★
                            </span>
                            <span class="rating-value">{course.rating.toFixed(1)}</span>.
                            {course.termSpan > 1 && (
                              <strong>
                                {" "}Spans 2 consecutive terms — paired with Term {pairInfo.pairedTerm}; clear this
                                slot to release both.
                              </strong>
                            )}
                            {isConflict && <strong> Not offered in {semester}.</strong>}
                            {courseMissing.length > 0 && (
                              <strong> 🔒 Still needs: {courseMissing.join(", ")}.</strong>
                            )}
                          </p>
                        )}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
            <button type="submit" class="btn-save-all">Save all</button>
          </form>
          <p class="slot-detail">
            Pick "— empty —" in a slot to clear it, then Save all.
          </p>
        </div>

        <aside class="requirement-panel card" aria-label="Outstanding requirements">
          <h2>Still to pick</h2>
          {outstanding.length === 0 ? (
            <p>Every requirement is satisfied.</p>
          ) : (
            <ul class="progress-list">
              {outstanding.map((group) => (
                <li class="progress-item pending">
                  <strong>{group.label}:</strong>{" "}
                  {group.rule === "all" ? (
                    <span>
                      {group.required.filter((c) => !group.assigned.includes(c)).map((c) => c.code).join(", ")}
                    </span>
                  ) : group.rule === "choose-n" ? (
                    <span>
                      {group.count === 1 ? "one of" : `choose ${group.count} of`} {group.required.map((c) => c.code).join(", ")}
                    </span>
                  ) : (
                    <span>
                      {group.units} units from: {group.required.map((c) => c.code).join(", ")}
                      {group.assigned.length > 0 && ` (have ${group.assigned.map((c) => c.code).join(", ")})`}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          )}
        </aside>
      </div>
    </main>
  </body>
</html>
