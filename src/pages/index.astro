---
import { getCurrentTerm, listCourses, listPlan, listPrerequisites } from "../lib/db";
import { completedBefore, lockedCourses } from "../lib/prerequisites";
import { computeProgress } from "../lib/requirements";
import { TERMS, termStatus } from "../lib/terms";
import "../styles.css";

const courses = listCourses();
const plan = listPlan();
const currentTerm = getCurrentTerm();

const courseByCode = new Map(courses.map((c) => [c.code, c]));
const planByCell = new Map(plan.map((p) => [`${p.term}-${p.position}`, p]));
const progress = computeProgress(courses, plan);
const totalUnits = plan.reduce((sum, p) => sum + (courseByCode.get(p.courseCode)?.units ?? 0), 0);

const completed = completedBefore(plan, currentTerm);
const locked = lockedCourses(courses, plan, listPrerequisites(), completed);

const STATUS_LABEL: Record<string, string> = {
  done: "Done",
  current: "Current",
  future: "Upcoming",
};
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Master of Computing roadmap</title>
  </head>
  <body>
    <nav aria-label="site">
      <div class="nav-brand">7706XMCOMP</div>
      <a href="/" aria-current="page">Roadmap</a>
      <a href="/select/">This semester</a>
      <a href="/completed/">Completed</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h1>Master of Computing roadmap</h1>
      <p>
        A slice of the Master of Computing (7706XMCOMP) course structure —
        Professional Computing specialisation — laid out as a 4-term
        timeline starting 2025 S2. This is the graduation audit: what's
        done, what's current, and what's still outstanding.
      </p>

      <form method="post" action="/api/settings" class="current-term-form card">
        <input type="hidden" name="returnTo" value="/" />
        <label for="currentTerm">Current term</label>
        <select id="currentTerm" name="currentTerm">
          {TERMS.map((t) => (
            <option value={t.term} selected={t.term === currentTerm}>
              Term {t.term} — {t.label}
            </option>
          ))}
        </select>
        <button>Update</button>
      </form>

      <p class="summary card" aria-live="polite">
        <strong>{totalUnits} units</strong> planned across all terms.
      </p>

      <h2>Graduation audit</h2>
      <ul class="progress-list card">
        {progress.map((group) => (
          <li class={group.satisfied ? "progress-item done" : "progress-item pending"}>
            <strong>{group.label}:</strong>{" "}
            {group.satisfied ? (
              <span>
                {group.rule === "all"
                  ? "all done"
                  : `chosen — ${group.assigned.map((c) => c.code).join(", ")}`}
              </span>
            ) : group.rule === "all" ? (
              <span>
                still need: {group.required.filter((c) => !group.assigned.includes(c)).map((c) => c.code).join(", ")}
              </span>
            ) : (
              <span>choose 1 of: {group.required.map((c) => c.code).join(", ")}</span>
            )}
          </li>
        ))}
      </ul>

      {locked.length > 0 && (
        <>
          <h2>Locked</h2>
          <ul class="progress-list card">
            {locked.map(({ course, missing }) => (
              <li class="progress-item locked">
                <span class="badge locked">🔒 locked</span>{" "}
                <strong>{course.code}</strong> — {course.title}: needs {missing.join(", ")} completed first.
              </li>
            ))}
          </ul>
        </>
      )}

      <h2>Timeline</h2>
      <div class="term-row">
        {TERMS.map((t) => {
          const status = termStatus(t.term, currentTerm);
          return (
            <div class={`term-card card status-${status}`}>
              <h3>
                Term {t.term} <span class="term-card-label">{t.label}</span>
              </h3>
              <span class={`badge status-${status}`}>{STATUS_LABEL[status]}</span>
              <ul class="term-slot-list">
                {[1, 2, 3, 4].map((position) => {
                  const entry = planByCell.get(`${t.term}-${position}`);
                  const course = entry ? courseByCode.get(entry.courseCode) : undefined;
                  return <li>{course ? `${course.code} — ${course.title}` : "— empty —"}</li>;
                })}
              </ul>
              <a href={`/select/?term=${t.term}`}>Edit this term →</a>
            </div>
          );
        })}
      </div>
    </main>
  </body>
</html>
